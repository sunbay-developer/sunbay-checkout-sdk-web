{
    "name": "@sunbay/checkout-sdk-protocol",
    "version": "0.0.2",
    "description": "Sunbay Checkout SDK ↔ hosted runtime 通信协议契约（单一真源）。",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "type-check": "tsc --noEmit"
    },
    "devDependencies": {
        "tsup": "^8.3.5",
        "typescript": "^5.6.3"
    }
}
