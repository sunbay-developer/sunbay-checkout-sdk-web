{
    "name": "@sunbay/checkout-sdk-protocol",
    "version": "0.0.7",
    "description": "Shared protocol contract between the Sunbay Checkout SDK and the Sunbay-hosted runtime (single source of truth).",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "type-check": "tsc --noEmit"
    },
    "devDependencies": {
        "tsup": "^8.3.5",
        "typescript": "^5.6.3"
    }
}
