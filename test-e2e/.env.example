# Test backend credentials template for the e2e suite.
# Copy to `.env.local` (git-ignored) and fill in your SANDBOX merchant credentials.
# server/server.mjs auto-loads `.env.local` on startup (Node 20.6+ process.loadEnvFile).

# Required — SANDBOX merchant credentials used to create a checkout session server-side.
# These never reach the browser. Leave empty to run only credential-free tests
# (session-dependent cases auto-skip; see support/env.ts).
API_KEY=
APP_ID=
MERCHANT_ID=

# Optional — safe defaults applied in server/server.mjs when omitted.
# PORT=8090
# OPEN_API_URL=https://open.sunbay-dev.com
# CURRENCY=USD

# Optional — origins the Playwright config reads (defaults shown).
# E2E_HARNESS_ORIGIN=http://localhost:8090
# E2E_HOSTED_ORIGIN=http://localhost:3000
# E2E_STUB_ORIGIN=http://localhost:8099
