{
    "name": "@sunbay/checkout-sdk-e2e",
    "version": "0.0.0",
    "private": true,
    "description": "Real-device (Playwright) e2e test suite for the Checkout Web SDK. Not published.",
    "type": "module",
    "scripts": {
        "server": "node server/server.mjs",
        "stub": "node server/stub-runtime.mjs",
        "test": "playwright test",
        "test:p0": "playwright test --grep @p0",
        "test:p1": "playwright test --grep @p1",
        "test:smoke": "playwright test --grep @p0",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "report": "playwright show-report",
        "install:browsers": "playwright install chromium"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0"
    },
    "dependencies": {
        "@sunbay/checkout-sdk-protocol": "workspace:*"
    }
}
