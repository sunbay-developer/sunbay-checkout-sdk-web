# Demo server credentials template.
# Copy to `.env.local` (git-ignored) and fill in your own merchant credentials.
# server.mjs auto-loads `.env.local` on startup (Node 20.6+ process.loadEnvFile).

# Required — merchant credentials used to create a checkout session server-side.
API_KEY=
APP_ID=
MERCHANT_ID=

# Optional — safe defaults applied in server.mjs when omitted.
# PORT=8080
# OPEN_API_URL=https://open.sunbay-dev.com
# CURRENCY=USD
