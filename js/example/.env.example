# Sandbox merchant credentials for the example session-mock backend.
# Copy to `.env.local` (git-ignored) and fill in your SANDBOX merchant credentials.
# server/server.mjs auto-loads `.env.local` on startup (Node 20.6+ process.loadEnvFile).
#
# Without these the server still serves the demo pages and /healthz, so you can
# inspect the UI; session creation (POST /api/create-session) returns 503.

# Required — SANDBOX merchant credentials used to create a checkout session
# server-side. These never reach the browser.
API_KEY=
APP_ID=
MERCHANT_ID=

# Optional — safe defaults applied in server/server.mjs when omitted.
# PORT=8095
# OPEN_API_URL=https://open.sunbay-dev.com
# CURRENCY=USD

# Optional — the hosted runtime origin the demo pages point the SDK at.
# Locally this is the `checkout` repo's `npm run dev` (:3000); or a deployed env.
# HOSTED_ORIGIN=http://localhost:3000
