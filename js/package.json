{
    "name": "@sunbay/checkout-sdk-js",
    "version": "0.0.5",
    "description": "Browser JS SDK for embedding Sunbay Checkout — the createCheckout entry point merchants use to render card fields and express wallet buttons in secure, Sunbay-hosted iframes.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@sunbay/checkout-sdk-protocol": "workspace:*"
    },
    "devDependencies": {
        "jsdom": "^29.1.1",
        "tsup": "^8.3.5",
        "typescript": "^5.6.3",
        "vitest": "^3.0.5"
    }
}
