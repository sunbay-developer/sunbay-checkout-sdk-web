{
    "name": "@sunbay/checkout-sdk-web",
    "version": "0.0.0",
    "private": true,
    "description": "Sunbay Checkout Web SDK monorepo 根（workspace 容器，不发布）。",
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @sunbay/checkout-sdk-protocol run build && pnpm --filter @sunbay/checkout-sdk-js run build",
        "build:protocol": "pnpm --filter @sunbay/checkout-sdk-protocol run build",
        "build:js": "pnpm --filter @sunbay/checkout-sdk-js run build",
        "type-check": "pnpm --filter @sunbay/checkout-sdk-protocol --filter @sunbay/checkout-sdk-js run type-check",
        "test": "pnpm --filter @sunbay/checkout-sdk-protocol --filter @sunbay/checkout-sdk-js run test",
        "test:e2e": "pnpm --filter @sunbay/checkout-sdk-e2e run test",
        "release": "bash scripts/release.sh",
        "release:dry": "bash scripts/release.sh"
    }
}
